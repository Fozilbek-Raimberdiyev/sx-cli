{
    "compilerOptions": {
        "lib": ["es2020"],
        "esModuleInterop": true,
        "module": "CommonJS",        // ES2022 o'rniga CommonJS ishlatamiz
        "moduleResolution": "node",
        "target": "es2022",
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,
        "baseUrl": ".",
        "skipLibCheck": true,
        "paths": {
            "@/*": ["src/ui/*"]
        }
    },
    "include": ["src/**/*.ts", "src/ui/**/*.ts", "src/ui/**/*.tsx", "src/ui/**/*.vue"],
    "exclude": ["node_modules", "dist"]
}